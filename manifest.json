{
  "manifest_version": 3,
  "name": "Boss Auto Greet",
  "version": "1.0.0",
  "description": "Filters jobs on Boss search pages into a queue, then greets them one by one at a human-like pace after you approve.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Boss Auto Greet"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "src/lib/logger.js",
        "src/lib/humanize.js",
        "src/lib/store.js",
        "src/lib/selectors.js",
        "src/lib/cities.js",
        "src/lib/filters.js",
        "src/content/scanner.js",
        "src/content/executor.js",
        "src/content/panel.js"
      ],
      "css": [
        "src/content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}